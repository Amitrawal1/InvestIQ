# Copy to backend/.env for local work. Never commit the real .env.
PORT=5500

# Local MySQL: leave DB_SSL unset. TiDB Cloud: port 4000 and DB_SSL=true.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=investiq
DB_SSL=

# Upstox app (developer console). The redirect URI must match the app's setting exactly.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Local: http://localhost:5500/upstox/callback   Vercel: https://invest-backend.vercel.app/upstox/callback
UPSTOX_REDIRECT_URI=http://localhost:5500/upstox/callback
# Any long random string; open /upstox/login?key=<this> to log in each day
UPSTOX_ADMIN_KEY=

KITE_API_KEY=
KITE_API_SECRET=
KITE_CLIENT_ID=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=

ALPHA_VANTAGE_API_KEY=

# "Continue with Google" (Google Cloud Console -> Credentials -> OAuth client ID, type Web application)
GOOGLE_CLIENT_ID=
